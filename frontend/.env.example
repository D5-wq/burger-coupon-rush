# 백엔드 API base URL.
# 개발 중에는 비워두면 vite dev 프록시(/api → localhost:8080)를 사용합니다.
# 배포 시 백엔드가 있으면 실제 API 주소를 넣으세요. 예) https://api.example.com/api
VITE_API_BASE_URL=

# 데모 모드: true 로 두면 백엔드 없이 목(mock) 데이터로 동작합니다.
# (백엔드 없이 Vercel 등에 프론트만 배포할 때 사용)
# 미설정이어도, 프로덕션 빌드인데 VITE_API_BASE_URL 이 비어 있으면 자동으로 데모 모드가 켜집니다.
VITE_DEMO_MODE=
